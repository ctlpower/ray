# ============================================
# CONFIGURATION WHATSAPP
# ============================================

# Numéro WhatsApp au format international (sans +)
WHATSAPP_NUMBER=237612345678

# ============================================
# CONFIGURATION SERVEUR
# ============================================

# Port sur lequel le serveur va tourner
PORT=3000

# Environnement (production/development)
NODE_ENV=production

# ============================================
# CONFIGURATION SÉCURITÉ
# ============================================

# Clé secrète pour les sessions (générer une chaîne aléatoire)
SESSION_SECRET=votre-session-secret-tres-long-et-complexe

# URL de votre application (pour CORS)
APP_URL=https://votre-app.render.com

# ============================================
# CONFIGURATION UPLOAD
# ============================================

# Taille maximale des fichiers uploadés (en bytes)
MAX_FILE_SIZE=10485760

# Types de fichiers autorisés
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif
